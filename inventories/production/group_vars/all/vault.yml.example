---
# Copy this file and encrypt it:
#
#   cp inventories/production/group_vars/all/vault.yml.example \
#      inventories/production/group_vars/all/vault.yml
#   $EDITOR inventories/production/group_vars/all/vault.yml
#   ansible-vault encrypt inventories/production/group_vars/all/vault.yml
#
# Never commit the unencrypted file. All values below are placeholders.

# SSH public keys allowed to log in as common_admin_user.
vault_admin_authorized_keys:
  - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIReplaceMeWithYourPublicKey ansible@example"

# GitLab initial root password (change it after the first login).
vault_gitlab_root_password: "ChangeMe-GitLab-Root-Password"

# Optional GitLab SMTP password. Leave the example value if SMTP is disabled.
vault_gitlab_smtp_password: "ChangeMe-GitLab-SMTP-Password"

# GitLab S3 backups (VK Cloud Object Storage).
vault_gitlab_backup_s3_access_key_id: "ChangeMe-GitLab-S3-Access-Key"
vault_gitlab_backup_s3_secret_access_key: "ChangeMe-GitLab-S3-Secret-Key"

# PostgreSQL replication and application credentials.
vault_postgres_replication_password: "ChangeMe-Postgres-Replication"
vault_postgres_app_password: "ChangeMe-Postgres-App"
vault_postgres_admin_password: "ChangeMe-Postgres-Admin"

# Valkey requirepass value.
vault_valkey_password: "ChangeMe-Valkey-Password"

# Observability stack.
# Grafana admin password and the basic-auth password used by Vector and
# Grafana when talking to VictoriaLogs.
vault_grafana_admin_password: "ChangeMe-Grafana-Admin"
vault_victorialogs_password: "ChangeMe-VictoriaLogs-Shipper"

# Grafana Alerting -> Telegram. Create a bot with @BotFather and get the chat
# ID (for a group, add the bot to the group and use the negative group ID).
vault_grafana_telegram_bot_token: "ChangeMe-Telegram-Bot-Token"
vault_grafana_telegram_chat_id: "ChangeMe-Telegram-Chat-ID"

# PostgreSQL postgres_exporter password (pg_monitor role on the primary).
vault_postgres_exporter_password: "ChangeMe-Postgres-Exporter"

# Container-log archive to S3 (Vector aws_s3 sink). If these are omitted, the
# Docker group falls back to the rclone or WAL-G S3 credentials. The bucket
# below must already exist.
vault_logs_s3_bucket: "tlcamp-logs"
vault_logs_s3_endpoint: "https://s3.example.com"
vault_logs_s3_region: "ru-msk"
vault_logs_s3_access_key_id: "ChangeMe-Logs-S3-Access-Key"
vault_logs_s3_secret_access_key: "ChangeMe-Logs-S3-Secret-Key"

# WAL-G physical PostgreSQL backups to S3.
# The libsodium key must be exactly 64 hex characters:
#   openssl rand -hex 32
# Store a second copy outside the server. Losing the key makes every
# encrypted backup unrecoverable.
# Primary target: VK Cloud Object Storage.
vault_walg_s3_access_key_id: "ChangeMe-WALG-VK-Access-Key"
vault_walg_s3_secret_access_key: "ChangeMe-WALG-VK-Secret-Key"
vault_walg_libsodium_key: "ChangeMe-64-hex-characters"

# Secondary target: Yandex Cloud Object Storage. Both values are required
# because the second cloud uses a separate service account.
vault_walg_secondary_s3_access_key_id: "ChangeMe-WALG-Yandex-Access-Key"
vault_walg_secondary_s3_secret_access_key: "ChangeMe-WALG-Yandex-Secret-Key"

# rclone / S3-compatible backup target.
vault_rclone_s3_endpoint: "https://s3.example.com"
vault_rclone_s3_access_key_id: "ChangeMe-Access-Key"
vault_rclone_s3_secret_access_key: "ChangeMe-Secret-Key"

# Optional: Proxmox API credentials for playbooks/proxmox-provision.yml.
vault_proxmox_api_password: "ChangeMe-Proxmox-Password"
