# Managed by Ansible
data_dir: /var/lib/vector

api:
  enabled: true
  address: 127.0.0.1:8686

sources:
  docker:
    type: docker_logs
    docker_host: unix:///var/run/docker.sock

transforms:
  enrich:
    type: remap
    inputs:
      - docker
    source: |
      .host = get_hostname!()
      .environment = "{{ vector_environment }}"
      .dataset = "docker"

sinks:
  victorialogs:
    type: http
    inputs:
      - enrich
    uri: >-
      https://{{ observability_hostname }}:{{ vector_victorialogs_port }}/insert/jsonline?_msg_field=message&_time_field=timestamp&_stream_fields=host,container_name,environment&_ignore_fields=source_type,label,container_created_at
    method: post
    auth:
      strategy: basic
      user: "{{ vector_victorialogs_username }}"
      password: "${VICTORIALOGS_PASSWORD}"
    tls:
      verify_certificate: true
    compression: gzip
    encoding:
      codec: json
    framing:
      method: newline_delimited
    healthcheck:
      enabled: false
    batch:
      max_bytes: 1048576
      timeout_secs: 2
    buffer:
      type: disk
      max_size: {{ vector_buffer_max_size }}
      when_full: block

{% if vector_logs_s3_enabled | bool %}
  s3:
    type: aws_s3
    inputs:
      - enrich
    bucket: "{{ vector_logs_s3_bucket }}"
    region: "{{ vector_logs_s3_region }}"
{% if vector_logs_s3_endpoint | length > 0 %}
    endpoint: "{{ vector_logs_s3_endpoint }}"
{% endif %}
    key_prefix: "{{ vector_logs_s3_prefix }}/%Y/%m/%d/%H/"
    filename_time_format: "%s"
    filename_append_uuid: true
    compression: gzip
    encoding:
      codec: json
    framing:
      method: newline_delimited
    auth:
      access_key_id: "${LOGS_S3_ACCESS_KEY_ID}"
      secret_access_key: "${LOGS_S3_SECRET_ACCESS_KEY}"
    force_path_style: {{ vector_logs_s3_force_path_style | bool | lower }}
    healthcheck:
      enabled: false
    batch:
      max_bytes: 10485760
      timeout_secs: 300
    buffer:
      type: disk
      max_size: {{ vector_buffer_max_size }}
      when_full: block
{% endif %}
