# Managed by Ansible
apiVersion: 1
datasources:
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: http://{{ victoriametrics_http_addr | default('127.0.0.1:8428') }}
    isDefault: true
    jsonData:
      httpMethod: POST
      timeInterval: "{{ victoriametrics_scrape_interval | default('30s') }}"

  - name: VictoriaLogs
    uid: victorialogs
    type: victoriametrics-logs-datasource
    access: proxy
    url: "https://{{ observability_hostname }}:{{ victorialogs_http_port | default(9428) }}"
    basicAuth: true
    basicAuthUser: "{{ victorialogs_auth_username | default('shipper') }}"
    secureJsonData:
      basicAuthPassword: {{ grafana_victorialogs_password | to_json }}
    jsonData:
      maxLines: 1000
