# Managed by Ansible
listen_addresses = '{{ postgres_listen_addresses }}'
port = {{ postgres_port }}

max_connections = {{ postgres_max_connections }}
shared_buffers = '{{ postgres_shared_buffers }}'
effective_cache_size = '{{ postgres_effective_cache_size }}'
maintenance_work_mem = '{{ postgres_maintenance_work_mem }}'
work_mem = '{{ postgres_work_mem }}'

wal_level = {{ postgres_wal_level }}
max_wal_senders = {{ postgres_max_wal_senders }}
max_replication_slots = {{ postgres_max_replication_slots }}
wal_keep_size = '{{ postgres_wal_keep_size }}'
max_slot_wal_keep_size = '{{ postgres_max_slot_wal_keep_size }}'
hot_standby = on
password_encryption = {{ postgres_password_encryption }}

{% if postgres_tls_enabled | bool %}
# TLS is mandatory for public traffic: pg_hba.conf uses hostssl for
# application clients and for the replication user. Replicas connect with
# sslmode=verify-full.
ssl = on
ssl_cert_file = '{{ postgres_tls_cert_path }}'
ssl_key_file = '{{ postgres_tls_key_path }}'
ssl_min_protocol_version = '{{ postgres_tls_min_protocol_version }}'
{% else %}
ssl = off
{% endif %}

{% if postgres_walg_archive_enabled | bool %}
# Archive WAL to S3 with WAL-G. Only the primary archives; a promoted replica
# needs an inventory/topology update and another role run.
archive_mode = on
{% if postgres_walg_secondary_enabled | bool %}
# The helper writes every segment to both configured S3 targets and succeeds
# only when both copies are present.
archive_command = '{{ postgres_walg_archive_script }} "%p"'
{% else %}
archive_command = '{{ postgres_walg_wrapper }} wal-push "%p"'
{% endif %}
archive_timeout = '{{ postgres_walg_archive_timeout }}'
{% else %}
archive_mode = off
{% endif %}

logging_collector = on
log_directory = '/var/log/postgresql'
log_filename = 'postgresql-%Y-%m-%d_%H%M%S.log'
log_rotation_age = 1d
log_rotation_size = 100MB
log_min_duration_statement = 1000
log_checkpoints = on
log_connections = on
log_disconnections = on
log_lock_waits = on
log_temp_files = 0
log_timezone = '{{ common_timezone | default('UTC') }}'
timezone = '{{ common_timezone | default('UTC') }}'
