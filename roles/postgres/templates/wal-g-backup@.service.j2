[Unit]
Description=WAL-G PostgreSQL backup (%i)
Wants=network-online.target
After=network-online.target postgresql@{{ postgres_version }}-{{ postgres_cluster }}.service

[Service]
Type=oneshot
User=postgres
Group=postgres
WorkingDirectory=/var/lib/postgresql
UMask=0077
ExecStart={{ postgres_walg_backup_script }} %i
TimeoutStartSec=infinity
