#!/bin/bash
# Managed by Ansible
set -euo pipefail

exec 9>"{{ postgres_walg_lock_file }}"
flock -x 9

mode="${1:?Usage: walg-backup full|diff}"
pgdata="$(jq -er '.PGDATA' "{{ postgres_walg_config_file }}")"

case "$mode" in
  full)
    export WALG_DELTA_MAX_STEPS=0
    ;;
  diff)
    export WALG_DELTA_MAX_STEPS={{ postgres_walg_delta_max_steps }}
    export WALG_DELTA_ORIGIN=LATEST_FULL
    ;;
  *)
    echo "Unknown backup mode: $mode" >&2
    exit 1
    ;;
esac

"{{ postgres_walg_wrapper }}" backup-push "$pgdata"

{% if postgres_walg_secondary_enabled | bool %}
copy_backup() {
  local attempt

  for attempt in 1 2 3; do
    if "{{ postgres_walg_bin }}" copy \
      --from "{{ postgres_walg_config_file }}" \
      --to "{{ postgres_walg_secondary_config_file }}" \
      "$@"; then
      return 0
    fi

    echo "Copy to the second S3 failed (attempt ${attempt}/3)" >&2
    if [[ "$attempt" -lt 3 ]]; then
      sleep 30
    fi
  done

  return 1
}

if [[ "$mode" == "full" ]]; then
  # Reconcile all retained backups on the weekly full run. Each backup's
  # required WAL range is copied as part of its chain, so a transiently missed
  # copy is repaired even if its timer run failed.
  copy_backup
else
  # The latest diff and its parent chain are enough for the daily run.
  copy_backup --backup-name LATEST --with-history
fi
{% endif %}

if [[ "$mode" == "full" ]]; then
  "{{ postgres_walg_wrapper }}" delete retain FULL {{ postgres_walg_retain_full }} --confirm
{% if postgres_walg_secondary_enabled | bool %}
  "{{ postgres_walg_secondary_wrapper }}" delete retain FULL {{ postgres_walg_retain_full }} --confirm
{% endif %}
fi
