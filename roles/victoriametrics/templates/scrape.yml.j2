# Managed by Ansible
global:
  scrape_interval: {{ victoriametrics_scrape_interval }}
  scrape_timeout: {{ victoriametrics_scrape_timeout }}

scrape_configs:
  - job_name: node
    static_configs:
      - targets:
{% for host in groups['all'] | sort %}
{% if hostvars[host].ansible_host is defined and not hostvars[host].ansible_host.startswith('203.0.113.') %}
          - "{{ hostvars[host].ansible_host }}:9100"
{% endif %}
{% endfor %}

  - job_name: postgres
    static_configs:
      - targets:
{% for host in groups['postgres'] | default([]) | sort %}
{% if hostvars[host].ansible_host is defined and not hostvars[host].ansible_host.startswith('203.0.113.') %}
          - "{{ hostvars[host].ansible_host }}:9187"
{% endif %}
{% endfor %}

  - job_name: victoriametrics
    static_configs:
      - targets:
          - "{{ victoriametrics_http_addr }}"

{% set vl_password = victorialogs_auth_password | default(vault_victorialogs_password | default('')) %}
{% if vl_password | length > 0 %}
  - job_name: victorialogs
    scheme: https
    tls_config:
      insecure_skip_verify: true
    static_configs:
      - targets:
          - "127.0.0.1:{{ victorialogs_http_port | default(9428) }}"
    basic_auth:
      username: "{{ victorialogs_auth_username | default('shipper') }}"
      password: "{{ vl_password }}"
{% endif %}

{% if blackbox_http_targets | default([]) | length > 0 %}
  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module:
        - http_2xx
    static_configs:
      - targets:
{% for target in blackbox_http_targets %}
          - "{{ target }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "127.0.0.1:{{ blackbox_exporter_port | default(9115) }}"
{% endif %}

{% if blackbox_victorialogs_targets | default([]) | length > 0 %}
  - job_name: blackbox_victorialogs
    metrics_path: /probe
    params:
      module:
        - https_2xx_or_401
    static_configs:
      - targets:
{% for target in blackbox_victorialogs_targets %}
          - "{{ target }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "127.0.0.1:{{ blackbox_exporter_port | default(9115) }}"
{% endif %}
