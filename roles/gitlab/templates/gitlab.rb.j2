# Managed by Ansible
external_url '{{ gitlab_external_url }}'
gitlab_rails['time_zone'] = '{{ gitlab_time_zone }}'
gitlab_rails['initial_root_password'] = {{ gitlab_initial_root_password | to_json }}
gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_shell_ssh_port }}
gitlab_rails['backup_path'] = "{{ gitlab_backup_dir }}"
gitlab_rails['backup_keep_time'] = {{ gitlab_backup_keep_days | int * 86400 }}

{% if gitlab_behind_proxy | bool %}
nginx['listen_port'] = {{ gitlab_nginx_listen_port }}
nginx['listen_https'] = false
nginx['proxy_set_headers'] = {
  "Host" => "$http_host",
  "X-Real-IP" => "$remote_addr",
  "X-Forwarded-For" => "$proxy_add_x_forwarded_for",
  "X-Forwarded-Proto" => "https",
  "X-Forwarded-Ssl" => "on"
}
gitlab_rails['trusted_proxies'] = {{ gitlab_trusted_proxies | to_json }}
{% else %}
{% if gitlab_letsencrypt_enable | bool %}
letsencrypt['enable'] = true
letsencrypt['contact_emails'] = {{ gitlab_letsencrypt_contact_emails | to_json }}
{% else %}
letsencrypt['enable'] = false
{% endif %}
{% endif %}

prometheus_monitoring['enable'] = {{ gitlab_prometheus_enabled | to_json }}

{% if gitlab_smtp_enabled | bool %}
gitlab_rails['smtp_enable'] = true
gitlab_rails['smtp_address'] = {{ gitlab_smtp_address | to_json }}
gitlab_rails['smtp_port'] = {{ gitlab_smtp_port }}
gitlab_rails['smtp_user_name'] = {{ gitlab_smtp_user_name | to_json }}
gitlab_rails['smtp_password'] = {{ gitlab_smtp_password | to_json }}
gitlab_rails['smtp_domain'] = {{ gitlab_smtp_domain | to_json }}
gitlab_rails['smtp_authentication'] = {{ gitlab_smtp_authentication | to_json }}
gitlab_rails['smtp_enable_starttls_auto'] = {{ gitlab_smtp_enable_starttls_auto | to_json }}
gitlab_rails['smtp_tls'] = {{ gitlab_smtp_tls | to_json }}
gitlab_rails['gitlab_email_from'] = {{ gitlab_smtp_from | to_json }}
{% endif %}
