# Managed by Ansible
filebeat.inputs:
  - type: filestream
    id: system-logs
    enabled: true
    paths:
      - /var/log/syslog
      - /var/log/auth.log
      - /var/log/kern.log
    fields:
      service: system
      environment: "{{ filebeat_environment }}"
    fields_under_root: true

{% if inventory_hostname in (groups['nginx'] | default([])) %}
  - type: filestream
    id: nginx-logs
    enabled: true
    paths:
      - /var/log/nginx/*.log
    fields:
      service: nginx
      environment: "{{ filebeat_environment }}"
    fields_under_root: true
{% endif %}

{% if inventory_hostname in (groups['docker'] | default([])) %}
  - type: filestream
    id: docker-logs
    enabled: true
    paths:
      - /var/lib/docker/containers/*/*.log
    fields:
      service: docker
      environment: "{{ filebeat_environment }}"
    fields_under_root: true
{% endif %}

{% if inventory_hostname in (groups['gitlab'] | default([])) %}
  - type: filestream
    id: gitlab-logs
    enabled: true
    paths:
      - /var/log/gitlab/*/*.log
    fields:
      service: gitlab
      environment: "{{ filebeat_environment }}"
    fields_under_root: true
{% endif %}

{% if inventory_hostname in (groups['postgres'] | default([])) %}
  - type: filestream
    id: postgres-logs
    enabled: true
    paths:
      - /var/log/postgresql/*.log
    fields:
      service: postgres
      environment: "{{ filebeat_environment }}"
    fields_under_root: true
{% endif %}

processors:
  - add_host_metadata:
      when.not.contains.tags: forwarded

output.logstash:
  hosts: ["{{ filebeat_logstash_host }}:{{ filebeat_logstash_port }}"]
  worker: {{ filebeat_worker }}
  bulk_max_size: {{ filebeat_bulk_max_size }}
  slow_start: true

setup.template.enabled: false
setup.ilm.enabled: false

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: "0640"
